    {
      "name": "scran",
      "version": "1.40.0",
      "license": "GPL-3.0-or-later",
      "url": "https://bioconductor.org/packages/release/bioc/html/scran.html"
    },
    {
      "name": "celldex",
      "version": "1.22.0",
      "license": "GPL-3.0-or-later",
      "url": "https://bioconductor.org/packages/release/bioc/html/celldex.html"
    }
